{
  "name": "@honyomi/plugin-runtime",
  "version": "0.1.0",
  "description": "Honyomi 插件运行时 shim。随 @honyomi/plugin-tools 安装。测试加载 ./shim；宿主打包执行 node build.mjs --rawfile <outfile> 写入应用 rawfile。",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./shim": "./dist/plugin_runtime_jsvm.js",
    "./build": "./build.mjs"
  },
  "files": [
    "src",
    "build.mjs",
    "register.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --import ./register.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "aes-js": "^3.1.2",
    "esbuild": "^0.28.2",
    "fast-text-encoding": "^1.0.6",
    "js-md5": "^0.8.3",
    "whatwg-url": "^14.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
